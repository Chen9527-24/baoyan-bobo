# 宝妍服务端配置。复制本文件为仓库根目录的 .env，再填自己的凭据。
# 只启用需要的能力即可。所有 Key 留空时可以体验本机文字演示。
# Git 会忽略 .env。凭据只填在服务端，不使用 VITE_ 前缀。
HOST=127.0.0.1
PORT=3001
DATA_PATH=.data/bobo.sqlite
TRIAL_ENABLED=false

# 火山方舟：文字回复、自动摘要、回答调整，以及配置匹配时的识图和原音理解。
CHAT_PROVIDER=volc
CHAT_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CHAT_API_KEY=
# 填账号开通的模型 ID。候选源码的识图分支要求 doubao-seed-2-1-lite-260915。
CHAT_MODEL=
# 可选。单独指定文字回复模型，留空沿用 CHAT_MODEL。
VOLC_TEXT_CHAT_MODEL=
VOLC_CHAT_THINKING=disabled

# 豆包语音：普通录音识别和语音合成，使用豆包语音的凭据。
ASR_PROVIDER=volc
TTS_PROVIDER=volc
VOLC_SPEECH_API_KEY=
# 旧鉴权用户可留空上方 Key，改填下面的 ID 和 Token。
VOLC_SPEECH_APP_ID=
VOLC_SPEECH_ACCESS_TOKEN=
VOLC_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE_ID=
# 可选。留空使用默认语速。
VOLC_TTS_SPEECH_RATE=

# 实时语音：启用时改为 true，并填写有实时语音权限的 Key。
VOLC_REALTIME_ENABLED=false
VOLC_REALTIME_API_KEY=
# 可选。留空使用内置默认实时音色。
VOLC_REALTIME_VOICE=

# 声纹识人：默认关闭。启用还需普通豆包语音识别和独立公网 HTTPS 源。
VOLC_VOICEPRINT_ENABLED=false
VOLC_VOICEPRINT_API_KEY=
VOLC_VOICEPRINT_AUDIO_ORIGIN=
# 使用旧声纹鉴权时，留空声纹 API Key，填以下两项。
VOLC_VOICEPRINT_APP_ID=
VOLC_VOICEPRINT_ACCESS_KEY=

# 非豆包适配器（可选）。仅在切换供应商时填写对应字段。
# 兼容接口将对应 PROVIDER 改为 openai，可共用 API_BASE_URL 与 API_KEY。
# 如更换文字服务，记得替换上方 CHAT_API_BASE_URL，或留空以使用对应默认配置。
API_BASE_URL=
API_KEY=
ASR_API_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
TTS_API_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
TTS_SPEED=
# 百炼使用 CHAT_PROVIDER=dashscope 或 ASR_PROVIDER=qwen。
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=
# MiniMax 使用 TTS_PROVIDER=minimax，并填写上方 TTS_API_BASE_URL、TTS_MODEL 和 TTS_VOICE。
MINIMAX_API_KEY=
