{
  "name": "baoyan-bobo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,h5 -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/server/tsconfig.json --noEmit",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "test": "tsx --test tests/*.test.ts",
    "start": "tsx apps/server/src/index.ts",
    "check:services": "tsx ops/check-services.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:server": "node ops/deploy/build-server.mjs",
    "start:production": "NODE_ENV=production node dist/server/apps/server/src/index.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "5.2.1",
    "lucide-react": "^0.577.0",
    "multer": "^2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^9.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.8"
  }
}
